{
  "manifest_version": 3,
  "name": "Sleep Calculator by Beverly Hills Bed",
  "version": "1.1",
  "description": "Calculate your perfect bedtime based on sleep cycles. Wake up refreshed, every time. By Beverly Hills Bed.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
